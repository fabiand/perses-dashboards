                "height": 9,
                "content": {
                  "$ref": "#/spec/panels/latency_quantiles_history"
                }
              }
            ]
          }
        },
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "Nodes",
              "collapse": {
                "open": true
              }
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 24,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/bb254c2f0b9c4fd5bc45f03e39813b16"
                }
              }
            ]
          }
        }
      ],
      "duration": "1h",
      "refreshInterval": "15s",
      "timezone": "local"
    }
  }
