                "width": 8,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/a7c3d8e1f2b4456789abcdef01234567"
                }
              }
            ]
          }
        },
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "Latency Distribution",
              "collapse": {
                "open": true
              }
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 24,
                "height": 13,
                "content": {
                  "$ref": "#/spec/panels/859fb288b6a546a0bea31d734264727c"
                }
              },
              {
                "x": 0,
                "y": 13,
