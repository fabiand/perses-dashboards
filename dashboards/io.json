[
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "io",
      "createdAt": "2026-09-18T14:33:54.933644325Z",
      "updatedAt": "2026-09-18T15:00:27.127455287Z",
      "version": 1,
      "project": "openshift-cnv"
    },
    "spec": {
      "display": {
        "name": "I/O"
      },
      "panels": {
        "53d12c6d478148e7b910be6a52e0ef52": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Node Imbalance",
              "description": "Quantile ratio (p95/p50) for I/O latency across nodes. Shows how much slower the slowest nodes are vs median. Threshold: <2.0 green (balanced), 2.0-4.0 yellow (moderate imbalance), >4.0 red (high imbalance).\n\nAnswers: How balanced is I/O latency across nodes?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 1
                },
                "max": 10,
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 2.0,
                      "color": "#FFB249"
                    },
                    {
                      "value": 4.0,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency:imbalance:ratio",
                      "seriesNameFormat": "Imbalance ratio (p95/p50)"
                    }
                  }
                }
              }
            ]
          }
        },
        "a7c3d8e1f2b4456789abcdef01234567": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Max Pressure (PSI)",
              "description": "Maximum I/O Pressure Stall Information (PSI) across all nodes. Shows the fraction of time tasks are waiting for I/O to complete. Higher values indicate I/O contention and performance degradation. Threshold: >10% moderate, >30% severe.\n\nAnswers: How much time are tasks waiting for I/O?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "percent-decimal",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 0.1,
                      "color": "#FFB249"
                    },
                    {
                      "value": 0.3,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "max(rate(node_pressure_io_waiting_seconds_total[1m]))",
                      "seriesNameFormat": "Max IO pressure (tasks waiting)"
                    }
                  }
                }
              }
            ]
          }
        },
        "latency_quantiles_gauge": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Latency Quantiles",
              "description": "I/O latency percentiles: p50 shows typical latency (50% of operations complete within this time), p95 indicates SLA performance (95% complete within this time), p99 shows tail latency (worst-case for 99% of operations). Lower is better.\n\nAnswers: What are the current I/O latency percentiles?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "seconds",
                  "decimalPlaces": 1
                },
                "max": 0.1,
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 0.03,
                      "color": "#FFB249"
                    },
                    {
                      "value": 0.06,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency:p50",
                      "seriesNameFormat": "p50 (median)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency:p95",
                      "seriesNameFormat": "p95"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency:p99",
                      "seriesNameFormat": "p99"
                    }
                  }
                }
              }
            ]
          }
        },
        "storage_utilization": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Utilization",
              "description": "Cluster-wide I/O device busy time as a percentage. Shows the fraction of wall-clock time when at least one I/O request was in flight on the busiest device. Threshold: <70% green (healthy capacity), 70-85% yellow (monitor usage), >85% red (high utilization).\n\nAnswers: How busy are the I/O devices?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "percent-decimal",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 0.7,
                      "color": "#FFB249"
                    },
                    {
                      "value": 0.85,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:utilization:ratio",
                      "seriesNameFormat": "Device busy time"
                    }
                  }
                }
              }
            ]
          }
        },
        "storage_utilization_history": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "I/O Utilization History",
              "description": "Historical trend of I/O device utilization showing maximum and average busy time across all devices. Max (orange) shows worst-case device pressure, Avg (green) shows typical cluster-wide utilization. Rising trends indicate growing I/O demand.\n\nAnswers: How has I/O device utilization changed over time?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom"
                },
                "querySettings": [
                  {
                    "colorMode": "fixed",
                    "colorValue": "#FF9F1C",
                    "queryIndex": 0
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#59CC8D",
                    "queryIndex": 1
                  }
                ],
                "visual": {
                  "areaOpacity": 0.2,
                  "connectNulls": false,
                  "display": "line",
                  "lineWidth": 1.5,
                  "pointRadius": 0
                },
                "yAxis": {
                  "format": {
                    "unit": "percent-decimal"
                  },
                  "label": "Device Busy Time",
                  "max": 1.0,
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "max(openshift:node:io:utilization:ratio)",
                      "seriesNameFormat": "Max"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "avg(openshift:node:io:utilization:ratio)",
                      "seriesNameFormat": "Avg"
                    }
                  }
                }
              }
            ]
          }
        },
        "859fb288b6a546a0bea31d734264727c": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Latency Distribution",
              "description": "Percentage distribution of I/O operations by latency buckets (host-to-device). Stacked areas show what portion of operations complete in each time range. Ideal: most operations in 0-10ms (green), minimal in >100ms (red). Shift toward slower buckets indicates I/O performance degradation.\n\nAnswers: How are I/O operations distributed across latency buckets?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom"
                },
                "querySettings": [
                  {
                    "colorMode": "fixed",
                    "colorValue": "#59CC8D",
                    "queryIndex": 0
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#FFCC00",
                    "queryIndex": 1
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#FFB249",
                    "queryIndex": 2
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#EE6C6C",
                    "queryIndex": 3
                  }
                ],
                "visual": {
                  "areaOpacity": 0.3,
                  "connectNulls": false,
                  "display": "line",
                  "lineStyle": "solid",
                  "lineWidth": 1.25,
                  "pointRadius": 2.75,
                  "stack": "all"
                },
                "yAxis": {
                  "format": {
                    "unit": "percent-decimal"
                  },
                  "label": "",
                  "max": 1,
                  "min": 0,
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency_bucket:ratio{le=\"0.01\"}",
                      "seriesNameFormat": "0ms - 10ms"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency_bucket:ratio{le=\"0.1\",g=\"0.01\"}",
                      "seriesNameFormat": "10ms - 100ms"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency_bucket:ratio{le=\"1.0\",g=\"0.1\"}",
                      "seriesNameFormat": "100ms - 1s"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency_bucket:ratio{le=\"+Inf\",g=\"1.0\"}",
                      "seriesNameFormat": "> 1s"
                    }
                  }
                }
              }
            ]
          }
        },
        "latency_quantiles_history": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Latency Quantiles History",
              "description": "Historical trend of storage I/O latency percentiles over time. Shows how p50 (median), p95, and p99 latencies evolve, helping identify performance degradation patterns and track the impact of changes. Rising trends indicate worsening I/O performance.\n\nAnswers: How have I/O latency percentiles changed over time?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom"
                },
                "querySettings": [
                  {
                    "colorMode": "fixed",
                    "colorValue": "#59CC8D",
                    "queryIndex": 0
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#FFB249",
                    "queryIndex": 1
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#EE6C6C",
                    "queryIndex": 2
                  }
                ],
                "visual": {
                  "connectNulls": false,
                  "display": "line",
                  "lineStyle": "solid",
                  "lineWidth": 1.5,
                  "pointRadius": 0
                },
                "yAxis": {
                  "format": {
                    "unit": "seconds"
                  },
                  "label": "",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency:p50",
                      "seriesNameFormat": "p50 (median)"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency:p95",
                      "seriesNameFormat": "p95"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:io:latency:p99",
                      "seriesNameFormat": "p99"
                    }
                  }
                }
              }
            ]
          }
        },
        "bb254c2f0b9c4fd5bc45f03e39813b16": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Latency Alerts History",
              "description": "Historical view of I/O latency alerts per node. Shows when and which nodes experienced high latency. Stacked areas indicate multiple nodes firing simultaneously. Use to correlate latency issues with specific events or changes.\n\nAnswers: Which nodes have experienced latency alerts and when?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom"
                },
                "visual": {
                  "areaOpacity": 0.3,
                  "connectNulls": false,
                  "display": "line",
                  "lineStyle": "solid",
                  "lineWidth": 1.25,
                  "pointRadius": 2.75,
                  "stack": "all"
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "count by (instance) (ALERTS{alertname=~\".*Latency.*High\"})",
                      "seriesNameFormat": "{{instance}}"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "At a Glance - I/O",
              "collapse": {
                "open": true
