[
  {
    "kind": "Dashboard",
    "metadata": {
      "name": "cpu",
      "createdAt": "2026-09-25T00:00:00.000000000Z",
      "updatedAt": "2026-09-25T00:00:00.000000000Z",
      "version": 1,
      "project": "openshift-cnv"
    },
    "spec": {
      "display": {
        "name": "CPU"
      },
      "panels": {
        "cluster_cpu_capacity": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Cluster CPU Capacity",
              "description": "Total physical CPU cores available across all nodes in the cluster. This represents the aggregate hardware CPU capacity before any system reservations or overcommitment.\n\nAnswers: How many physical CPU cores does the cluster have?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "decimal"
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:cpu:capacity:count",
                      "seriesNameFormat": "Physical CPU cores"
                    }
                  }
                }
              }
            ]
          }
        },
        "cluster_vcpu_count": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Cluster vCPU Count",
              "description": "Total virtual CPUs allocated across all VMs running in the cluster. This is the sum of all vCPUs configured for virtual machines, regardless of actual usage.\n\nAnswers: How many virtual CPUs are allocated to VMs cluster-wide?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "decimal"
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:cpu:vcpu:count",
                      "seriesNameFormat": "Total vCPUs"
                    }
                  }
                }
              }
            ]
          }
        },
        "cluster_cpu_overcommit": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Cluster CPU Overcommit",
              "description": "Ratio of total virtual CPUs to physical CPU cores across the cluster. Values below 1.5 indicate conservative allocation (green), 1.5-2.0 shows moderate overcommit (yellow), and above 2.0 indicates aggressive overcommit that may impact performance (red).\n\nAnswers: What is the cluster-wide CPU overcommit ratio?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "percent-decimal"
                },
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 1.5,
                      "color": "#FFB249"
                    },
                    {
                      "value": 2.0,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:cpu:overcommit:ratio",
                      "seriesNameFormat": "Overcommit ratio"
                    }
                  }
                }
              }
            ]
          }
        },
        "cluster_cpu_utilization": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Cluster CPU Utilization",
              "description": "Percentage of cluster CPU capacity currently in use by workloads. Shows aggregate utilization across all nodes. Threshold: <70% green (healthy capacity), 70-85% yellow (monitor usage), >85% red (high utilization).\n\nAnswers: How much of the cluster's CPU is being used?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "percent-decimal",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 0.7,
                      "color": "#FFB249"
                    },
                    {
                      "value": 0.85,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:cpu:utilization:ratio{scope=\"workloads\"}",
                      "seriesNameFormat": "CPU utilization"
                    }
                  }
                }
              }
            ]
          }
        },
        "node_cpu_imbalance": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Node CPU Imbalance",
              "description": "Coefficient of variation for CPU allocation across nodes. Measures how evenly CPU load is distributed. Lower values indicate balanced distribution; higher values mean some nodes are heavily loaded while others are underutilized. Threshold: <0.3 green (balanced), 0.3-0.6 yellow (moderate imbalance), >0.6 red (high imbalance).\n\nAnswers: How balanced is CPU allocation across nodes?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "decimal",
                  "decimalPlaces": 1
                },
                "max": 1,
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 0.3,
                      "color": "#FFB249"
                    },
                    {
                      "value": 0.6,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:cpu:imbalance:ratio{scope=\"workloads\"}",
                      "seriesNameFormat": "Coefficient of Variation"
                    }
                  }
                }
              }
            ]
          }
        },
        "cpu_pressure": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "CPU Pressure (PSI)",
              "description": "Maximum CPU Pressure Stall Information (PSI) across all nodes. Shows the fraction of time tasks are waiting for CPU on the most pressured node. Higher values indicate CPU contention and performance degradation. Threshold: <10% green (healthy), 10-30% yellow (moderate pressure), >30% red (high contention).\n\nAnswers: What is the worst-case CPU pressure in the cluster?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "percent-decimal",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 0.1,
                      "color": "#FFB249"
                    },
                    {
                      "value": 0.3,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "topk(1, openshift:node:cpu:pressure:ratio{severity=\"some\"} @ end())",
                      "seriesNameFormat": "{{node}}"
                    }
                  }
                }
              }
            ]
          }
        },
        "vcpu_overcommit": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "vCPU Overcommit",
              "description": "Total virtual CPUs assigned to VMs as a percentage of physical CPU capacity. Values >100% indicate CPU overcommitment. Threshold: <120% green (acceptable), 120-150% yellow (monitor VM usage), >150% red (high overcommit risk). Overcommitment is safe when VMs don't simultaneously reach peak CPU usage.\n\nAnswers: Is the cluster overcommitting virtual CPUs?"
            },
            "plugin": {
              "kind": "GaugeChart",
              "spec": {
                "calculation": "last-number",
                "format": {
                  "unit": "percent",
                  "decimalPlaces": 1
                },
                "thresholds": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "#59CC8D"
                    },
                    {
                      "value": 120,
                      "color": "#FFB249"
                    },
                    {
                      "value": 150,
                      "color": "#EE6C6C"
                    }
                  ]
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:cpu:overcommit:ratio{scope=\"virtual\"} * 100",
                      "seriesNameFormat": "vCPU overcommit"
                    }
                  }
                }
              }
            ]
          }
        },
        "cluster_cpu_utilization_history": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Cluster CPU Utilization History",
              "description": "Historical trend of cluster-wide CPU utilization showing busy and idle CPU time. Stacked areas show CPU time consumed by system components (red), workload processes (orange), and idle workload capacity (green). The blue dashed line shows committed virtual CPUs - worst-case demand if all VMs used their full vCPU allocation. Rising busy trends indicate growing CPU demand.\n\nAnswers: How has cluster CPU utilization changed over time for system and workloads?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom"
                },
                "querySettings": [
                  {
                    "colorMode": "fixed",
                    "colorValue": "#EE6C6C",
                    "queryIndex": 0
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#FF9F1C",
                    "queryIndex": 1
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#59CC8D",
                    "queryIndex": 2
                  },
                  {
                    "colorMode": "fixed",
                    "colorValue": "#6BB6FF",
                    "queryIndex": 3,
                    "lineStyle": "dashed",
                    "stack": false,
                    "areaOpacity": 0
                  }
                ],
                "visual": {
                  "areaOpacity": 0.2,
                  "connectNulls": false,
                  "display": "line",
                  "lineWidth": 1.5,
                  "pointRadius": 0,
                  "stack": "all"
                },
                "yAxis": {
                  "format": {
                    "unit": "seconds"
                  },
                  "label": "CPU Utilization",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "sum(openshift:cluster:cpu:seconds{scope=\"system\"})",
                      "seriesNameFormat": "System"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:cpu:seconds{scope=\"workloads\", utilized=\"true\"}",
                      "seriesNameFormat": "Workloads - Busy"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:cluster:cpu:seconds{scope=\"workloads\", utilized=\"false\"}",
                      "seriesNameFormat": "Workloads - Idle"
                    }
                  }
                }
              },
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "sum(openshift:cluster:virtual:cpu:seconds)",
                      "seriesNameFormat": "Committed"
                    }
                  }
                }
              }
            ]
          }
        },
        "node_cpu_capacity": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Node CPU Capacity",
              "description": "Physical CPU core count per node over time. Shows the hardware capacity available on each node. Use this to identify nodes with different CPU configurations and track capacity changes when nodes are added or removed.\n\nAnswers: How many physical CPU cores does each node have?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom"
                },
                "visual": {
                  "connectNulls": false,
                  "display": "line",
                  "lineStyle": "solid",
                  "lineWidth": 1.5,
                  "pointRadius": 0
                },
                "yAxis": {
                  "format": {
                    "unit": "decimal"
                  },
                  "label": "CPU cores",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:node:cpu:capacity:count",
                      "seriesNameFormat": "{{node}}"
                    }
                  }
                }
              }
            ]
          }
        },
        "node_vcpu_overcommit": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "Node vCPU Overcommit",
              "description": "Virtual CPU overcommit ratio per node over time. Shows the ratio of VM vCPUs to physical cores on each node. Values above 1.0 indicate overcommitment. Use this to identify hotspots where VMs may compete for CPU resources and to balance VM placement across nodes.\n\nAnswers: What is the vCPU overcommit ratio on each node?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom"
                },
                "visual": {
                  "connectNulls": false,
                  "display": "line",
                  "lineStyle": "solid",
                  "lineWidth": 1.5,
                  "pointRadius": 0
                },
                "yAxis": {
                  "format": {
                    "unit": "decimal"
                  },
                  "label": "Overcommit ratio",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "openshift:node:cpu:overcommit:ratio",
                      "seriesNameFormat": "{{node}}"
                    }
                  }
                }
              }
            ]
          }
        },
        "vm_vcpu_count": {
          "kind": "Panel",
          "spec": {
            "display": {
              "name": "VM vCPU Count",
              "description": "Virtual CPU count per VM over time, showing the top VMs by vCPU allocation. Helps identify VMs with high CPU requirements and track vCPU allocation changes. Use this to understand which VMs consume the most CPU resources and plan capacity accordingly.\n\nAnswers: Which VMs have the most vCPUs allocated?"
            },
            "plugin": {
              "kind": "TimeSeriesChart",
              "spec": {
                "legend": {
                  "position": "bottom"
                },
                "visual": {
                  "connectNulls": false,
                  "display": "line",
                  "lineStyle": "solid",
                  "lineWidth": 1.5,
                  "pointRadius": 0
                },
                "yAxis": {
                  "format": {
                    "unit": "decimal"
                  },
                  "label": "vCPUs",
                  "show": true
                }
              }
            },
            "queries": [
              {
                "kind": "TimeSeriesQuery",
                "spec": {
                  "plugin": {
                    "kind": "PrometheusTimeSeriesQuery",
                    "spec": {
                      "query": "topk(10, openshift:vm:cpu:vcpu:count)",
                      "seriesNameFormat": "{{namespace}}/{{name}}"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "layouts": [
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "At a Glance",
              "collapse": {
                "open": true
              }
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/cluster_cpu_utilization"
                }
              },
              {
                "x": 6,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/vcpu_overcommit"
                }
              },
              {
                "x": 12,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/cpu_pressure"
                }
              },
              {
                "x": 18,
                "y": 0,
                "width": 6,
                "height": 6,
                "content": {
                  "$ref": "#/spec/panels/node_cpu_imbalance"
                }
              },
              {
                "x": 0,
                "y": 6,
                "width": 24,
                "height": 9,
                "content": {
                  "$ref": "#/spec/panels/cluster_cpu_utilization_history"
                }
              }
            ]
          }
        },
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "Per Node",
              "collapse": {
                "open": false
              }
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 12,
                "height": 9,
                "content": {
                  "$ref": "#/spec/panels/node_cpu_capacity"
                }
              },
              {
                "x": 12,
                "y": 0,
                "width": 12,
                "height": 9,
                "content": {
                  "$ref": "#/spec/panels/node_vcpu_overcommit"
                }
              }
            ]
          }
        },
        {
          "kind": "Grid",
          "spec": {
            "display": {
              "title": "VMs",
              "collapse": {
                "open": false
              }
            },
            "items": [
              {
                "x": 0,
                "y": 0,
                "width": 24,
                "height": 9,
                "content": {
                  "$ref": "#/spec/panels/vm_vcpu_count"
                }
              }
            ]
          }
        }
      ],
      "duration": "1h",
      "refreshInterval": "15s",
      "timezone": "local"
    }
  }
]
