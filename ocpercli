#!/bin/bash
set -euo pipefail

VERSION="0.1.0"
SCRIPT_NAME="ocpercli"

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
$SCRIPT_NAME - Perses Dashboard CLI for OpenShift

Usage: $SCRIPT_NAME <command> [OPTIONS] <dashboard-file>

Commands:
  apply       Create or update Perses dashboards in the cluster
  delete      Delete Perses dashboards from the cluster

Apply Options:
  -n, --namespace <ns>  Target namespace (default: current namespace)
  -p, --project <name>  Override project name in dashboard metadata
  -d, --dry-run        Show what would be applied without applying
  -h, --help           Show this help message
  -v, --version        Show version

Delete Options:
  -n, --namespace <ns>  Target namespace (default: current namespace)
  -d, --dry-run        Show what would be deleted without deleting
  -h, --help           Show this help message

Arguments:
  <dashboard-file>    Path to Perses dashboard JSON file

Examples:
  $SCRIPT_NAME apply dashboards/overview.json
  $SCRIPT_NAME apply -n monitoring dashboards/memory.json
  $SCRIPT_NAME apply --dry-run dashboards/cpu.json
  $SCRIPT_NAME delete dashboards/overview.json
  $SCRIPT_NAME delete -n monitoring dashboards/memory.json

Requirements:
  - oc (OpenShift CLI) must be installed and configured
  - kubectl can be used as fallback
  - Perses CRDs must be installed in the cluster

EOF
    exit 0
}

version() {
    echo "$SCRIPT_NAME version $VERSION"
    exit 0
}

error() {
    echo -e "${RED}Error: $1${NC}" >&2
    exit 1
}

info() {
    echo -e "${GREEN}✓ $1${NC}"
}

warn() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

# Check if oc or kubectl is available
check_cli() {
    if command -v oc &> /dev/null; then
        echo "oc"
    elif command -v kubectl &> /dev/null; then
        echo "kubectl"
    else
        error "Neither 'oc' nor 'kubectl' found. Please install OpenShift CLI (oc) or kubectl."
    fi
}

# Get current namespace
get_namespace() {
    local cli=$1
    local ns=""

    if [[ "$cli" == "oc" ]]; then
        ns=$(oc project -q 2>/dev/null || echo "")
    else
        ns=$(kubectl config view --minify --output 'jsonpath={..namespace}' 2>/dev/null || echo "")
    fi

    if [[ -z "$ns" ]]; then
        ns="default"
    fi

    echo "$ns"
}

# Validate Perses dashboard JSON
validate_dashboard() {
    local file=$1

    if [[ ! -f "$file" ]]; then
        error "File not found: $file"
    fi

    if ! jq empty "$file" 2>/dev/null; then
        error "Invalid JSON in file: $file"
    fi

    local file_type=$(jq -r 'type' "$file")
    if [[ "$file_type" != "array" ]]; then
        error "File must contain an array of dashboards, got: $file_type"
    fi

    local count=$(jq 'length' "$file")
    if [[ "$count" -eq 0 ]]; then
        error "File contains an empty array"
    fi

    # Validate first element is a dashboard
    local kind=$(jq -r '.[0].kind // empty' "$file")
    if [[ "$kind" != "Dashboard" ]]; then
        error "Array elements are not Perses Dashboards (kind: $kind)"
    fi
}

# Get dashboard count
get_dashboard_count() {
    local file=$1
    jq 'length' "$file"
}

# Wrap Perses dashboard in Kubernetes Custom Resource
wrap_dashboard() {
    local file=$1
    local index=$2
    local namespace=$3
    local project_override=$4

    # Build the PersesDashboard CRD using jq
    jq -n \
        --arg ns "$namespace" \
        --arg proj_override "$project_override" \
        --argjson dashboard "$(jq ".[$index]" "$file")" \
        '{
            apiVersion: "perses.dev/v1alpha2",
            kind: "PersesDashboard",
            metadata: {
                name: $dashboard.metadata.name,
                namespace: $ns,
                labels: {
                    "perses.dev/project": (if $proj_override != "" then $proj_override else ($dashboard.metadata.project // "default") end)
                }
            },
            spec: ($dashboard.spec + {
                project: (if $proj_override != "" then $proj_override else ($dashboard.metadata.project // "default") end)
            })
        }'
}

# Apply dashboards
cmd_apply() {
    local file=""
    local namespace=""
    local project=""
    local dry_run=false
    local cli=$(check_cli)

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -n|--namespace)
                namespace="$2"
                shift 2
                ;;
            -p|--project)
                project="$2"
                shift 2
                ;;
            -d|--dry-run)
                dry_run=true
                shift
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$file" ]]; then
                    file="$1"
                else
                    error "Multiple files not supported. Got: '$file' and '$1'"
                fi
                shift
                ;;
        esac
    done

    # Validate arguments
    if [[ -z "$file" ]]; then
        error "No dashboard file specified. Use -h for help."
    fi

    info "Using CLI: $cli"

    # Validate dashboard file
    validate_dashboard "$file"
    local count=$(get_dashboard_count "$file")
    info "Found $count dashboard(s) in file"

    # Get or set namespace
    if [[ -z "$namespace" ]]; then
        namespace=$(get_namespace "$cli")
    fi
    info "Namespace: $namespace"

    # Show project override if set
    if [[ -n "$project" ]]; then
        info "Project override: $project"
    fi

    # Process each dashboard
    for ((i=0; i<count; i++)); do
        local dashboard_name=$(jq -r ".[$i].metadata.name" "$file")

        if [[ "$count" -gt 1 ]]; then
            echo ""
            info "Processing dashboard $((i+1))/$count: $dashboard_name"
        else
            info "Dashboard: $dashboard_name"
        fi

        # Generate Kubernetes resource
        local k8s_resource=$(wrap_dashboard "$file" "$i" "$namespace" "$project")

        if [[ "$dry_run" == true ]]; then
            warn "Dry-run mode - showing resource that would be applied:"
            echo "---"
            echo "$k8s_resource"
            echo "---"
        else
            # Apply to cluster
            echo "$k8s_resource" | $cli apply -f - -n "$namespace"

            if [[ $? -eq 0 ]]; then
                info "Dashboard '$dashboard_name' applied successfully"
            else
                error "Failed to apply dashboard '$dashboard_name'"
            fi
        fi
    done
}

# Delete dashboards
cmd_delete() {
    local file=""
    local namespace=""
    local dry_run=false
    local cli=$(check_cli)

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -n|--namespace)
                namespace="$2"
                shift 2
                ;;
            -d|--dry-run)
                dry_run=true
                shift
                ;;
            -*)
                error "Unknown option: $1"
                ;;
            *)
                if [[ -z "$file" ]]; then
                    file="$1"
                else
                    error "Multiple files not supported. Got: '$file' and '$1'"
                fi
                shift
                ;;
        esac
    done

    # Validate arguments
    if [[ -z "$file" ]]; then
        error "No dashboard file specified. Use -h for help."
    fi

    info "Using CLI: $cli"

    # Validate dashboard file
    validate_dashboard "$file"
    local count=$(get_dashboard_count "$file")
    info "Found $count dashboard(s) in file"

    # Get or set namespace
    if [[ -z "$namespace" ]]; then
        namespace=$(get_namespace "$cli")
    fi
    info "Namespace: $namespace"

    # Process each dashboard
    for ((i=0; i<count; i++)); do
        local dashboard_name=$(jq -r ".[$i].metadata.name" "$file")

        if [[ "$count" -gt 1 ]]; then
            echo ""
            info "Processing dashboard $((i+1))/$count: $dashboard_name"
        else
            info "Dashboard: $dashboard_name"
        fi

        if [[ "$dry_run" == true ]]; then
            warn "Dry-run mode - would delete: PersesDashboard/$dashboard_name in namespace $namespace"
        else
            # Delete from cluster
            $cli delete persesdashboard "$dashboard_name" -n "$namespace"

            if [[ $? -eq 0 ]]; then
                info "Dashboard '$dashboard_name' deleted successfully"
            else
                error "Failed to delete dashboard '$dashboard_name'"
            fi
        fi
    done
}

# Main function
main() {
    # Handle global flags before command
    if [[ $# -eq 0 ]]; then
        usage
    fi

    case $1 in
        -h|--help)
            usage
            ;;
        -v|--version)
            version
            ;;
        apply)
            shift
            cmd_apply "$@"
            ;;
        delete)
            shift
            cmd_delete "$@"
            ;;
        *)
            error "Unknown command: $1. Use 'apply' or 'delete'. See -h for help."
            ;;
    esac
}

# Check for jq
if ! command -v jq &> /dev/null; then
    error "jq is required but not installed. Please install jq."
fi

main "$@"
